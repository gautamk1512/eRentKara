# ==========================================
# eRentKarar.com — Environment Configuration
# ==========================================

# Core Django Settings
DEBUG=True
SECRET_KEY=change-me-to-a-secure-random-key-in-production-erentkarar-2026
ALLOWED_HOSTS=localhost,127.0.0.1,erentkarar.com,*.erentkarar.com
FRONTEND_URL=http://localhost:3000

# Database Configuration (Defaults to SQLite for local development if empty)
# Format: postgresql://user:password@localhost:5432/erentkarar_db
DATABASE_URL=

# Cache & Message Queue
REDIS_URL=redis://localhost:6379/0

# Storage Provider Abstraction: local | s3 | r2 | oci
STORAGE_PROVIDER=local
STORAGE_BUCKET_NAME=erentkarar-vault
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION_NAME=ap-south-1
STORAGE_ENDPOINT_URL=

# eSign & Stamping Integration (zoho | leegality | digio | mock)
ESIGN_PROVIDER=zoho
ESTAMP_PROVIDER=zoho
IDENTITY_PROVIDER=zoho

# Zoho Sign India Integration (https://sign.zoho.in)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_BASE_URL=https://sign.zoho.in
ZOHO_OAUTH_URL=https://accounts.zoho.in/oauth/v2/token
ZOHO_WEBHOOK_SECRET=

# Alternative Providers (Leegality / Digio)
LEEGALITY_API_URL=https://sandbox.leegality.com/api/v2
LEEGALITY_AUTH_TOKEN=
LEEGALITY_WEBHOOK_SECRET=

# Payment Gateway (e.g. Razorpay / Cashfree / Mock)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Communication & Notification Channels
WHATSAPP_PROVIDER=mock
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=eRentKarar <no-reply@erentkarar.com>

# Ekrar AI Assistant
AI_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
